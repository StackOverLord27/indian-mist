# Copy to .env.local and fill in. Never commit real values. See docs/env.md for which
# environment (Production / Preview / Development) needs which variable.
# Only variables the code reads are listed. Names ending in _SECRET, _TOKEN, _PASS are secrets.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=

# --- Auth (use long random strings, different for each environment) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# The one admin account. Compared case-insensitively. If empty, nobody can sign in as admin.
SUPER_ADMIN_EMAIL=

# --- Redis (Upstash REST): rate limits, sign-in lockout, OTP codes, pending checkouts ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Razorpay (test keys start with rzp_test_, live keys with rzp_live_) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID. Public on purpose: the checkout page uses it in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mail (SMTP): verification codes and contact-form messages ---
SMTP_HOST=
# Optional, defaults to 587. Port 465 uses TLS from the start.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The "from" address, for example: no-reply@yourdomain.com
SMTP_FROM=
